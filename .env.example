# ============================================================
# YottaPay AI – Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=yottapay_ai

# --- Application ---
APP_NAME=YottaPay AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
DEBUG=true

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- Gemini API (Optional) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Matching Engine Tolerances ---
PRICE_TOLERANCE_PCT=2.0
QTY_TOLERANCE_PCT=0.0
TAX_TOLERANCE_PCT=0.5
TOTAL_TOLERANCE_PCT=0.5

# --- CORS ---
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/yottapay.log
